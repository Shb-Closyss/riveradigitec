<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Helpdesk Ticket Form View Inherit -->
    <record id="helpdesk_ticket_view_form_inherit_rivera_lot" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.inherit.rivera.lot</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email_cc']" position="after">
                <field name="product_id" options="{'no_create': True}" groups="stock.group_stock_user"/>
                <field name="lot_id" options="{'no_create': True}" domain="product_id and [('product_id', '=', product_id)] or []" context="{'default_product_id': product_id}" groups="stock.group_stock_user"/>
                <field name="manufacturing_date" readonly="1" force_save="1" invisible="not product_id and not lot_id" groups="stock.group_stock_user"/>
                <field name="import_date" readonly="1" force_save="1" invisible="not product_id and not lot_id" groups="stock.group_stock_user"/>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="under_warrenty" readonly="1" force_save="1" invisible="not product_id and not lot_id" groups="stock.group_stock_user"/>
                <field name="warrenty_expiry_date" readonly="1" force_save="1" invisible="not under_warrenty or (not product_id and not lot_id)" groups="stock.group_stock_user"/>
            </xpath>
        </field>
    </record>

    <!-- Helpdesk Ticket Tree / List View Inherit -->
    <record id="helpdesk_tickets_view_tree_inherit_rivera_lot" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list.inherit.rivera.lot</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="product_id" optional="show" groups="stock.group_stock_user"/>
                <field name="lot_id" optional="show" groups="stock.group_stock_user"/>
                <field name="manufacturing_date" optional="hide" groups="stock.group_stock_user"/>
                <field name="import_date" optional="hide" groups="stock.group_stock_user"/>
                <field name="under_warrenty" optional="hide" groups="stock.group_stock_user"/>
                <field name="warrenty_expiry_date" optional="hide" groups="stock.group_stock_user"/>
            </xpath>
        </field>
    </record>
</odoo>
