<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Stock Lot Form View Inherit -->
    <record id="stock_lot_form_view_inherit" model="ir.ui.view">
        <field name="name">stock.lot.form.view.inherit</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[.//field[@name='ref']]" position="after">
                <group string="WARRANTY">
                    <field name="under_warrenty"/>
                    <field name="warrenty_expiry_date" invisible="not under_warrenty"/>
                    <field name="manufacturing_date"/>
                    <field name="import_date" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Stock Lot Tree / List View Inherit -->
    <record id="stock_lot_tree_view_inherit" model="ir.ui.view">
        <field name="name">stock.lot.tree.view.inherit</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_date']" position="after">
                <field name="manufacturing_date" optional="show"/>
                <field name="import_date" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>