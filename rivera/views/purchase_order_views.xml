<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_rivera_brand" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.rivera.brand</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Brand on Purchase Order Line List -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="brand_id" optional="show"/>
            </xpath>

            <!-- Brand on Purchase Order Line Form -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="after">
                <field name="brand_id"/>
            </xpath>
        </field>
    </record>
</odoo>
