<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_rivera" model="ir.ui.view">
        <field name="name">res.company.form.inherit.rivera</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']//group" position="after">
                <group string="Invoicing Settings">
                    <field name="overwrite_invoice_number"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
