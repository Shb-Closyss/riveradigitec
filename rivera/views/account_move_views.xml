<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_rivera_brand" model="ir.ui.view">
        <field name="name">account.move.form.inherit.rivera.brand</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Brand on Invoice / Bill Line List -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="brand_id" optional="show"/>
            </xpath>

            <!-- Brand on Invoice / Bill Line Form -->
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='product_id']" position="after">
                <field name="brand_id"/>
            </xpath>

            <!-- Brand on Journal Items (line_ids) List -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='account_id']" position="after">
                <field name="brand_id" optional="hide"/>
            </xpath>

            <!-- Order ID and Online Invoice No. on Customer Invoices -->
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="order_id" invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')" readonly="state != 'draft'"/>
                <field name="online_invoice_no" invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')" readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
