<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily Dispatch Notification Scheduled Action -->
        <record id="ir_cron_daily_dispatch_notification" model="ir.cron">
            <field name="name">Rivera: Send Daily Dispatch Notifications</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_daily_dispatch_emails()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
