<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_account_approval_route" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account.approval.route</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="25"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']/block[@id='invoicing_settings']" position="after">
                <block title="Accounting Approval Routing" id="accounting_approval_routing">
                    <setting id="use_approval_route_out_invoice"
                             title="Customer Invoices/Refunds Approval"
                             help="Configure dynamic approval workflow for customer invoices and credit notes.">
                        <field name="use_approval_route_out_invoice" widget="radio"/>
                    </setting>
                    <setting id="use_approval_route_in_invoice"
                             title="Vendor Bills/Refunds Approval"
                             help="Configure dynamic approval workflow for vendor bills and debit notes.">
                        <field name="use_approval_route_in_invoice" widget="radio"/>
                    </setting>
                    <setting id="use_approval_route_entry"
                             title="Journal Entries Approval"
                             help="Configure dynamic approval workflow for miscellaneous journal entries.">
                        <field name="use_approval_route_entry" widget="radio"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
