<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="product_template_inherit" model="ir.ui.view">
        <field name="name">product.template_inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref='product.product_template_only_form_view'/>
        <field name="arch" type="xml">
            <xpath position="inside" expr="//header">
                <button type="object" string="Send for approval" name="action_send_approval" class="btn-primary"
                        invisible="active == True or sale_approval_status != 'new'" style="height: 400px;"/>
                <button name="action_approve" type="object" string="Approve" class="btn btn-success"
                        invisible="not is_current_approver or active == True or sale_approval_status != 'sent'"/>
                <button name="action_reject" type="object" string="Reject" class="btn btn-danger"
                        invisible="not is_current_approver or active == True or sale_approval_status != 'sent'"/>
                <field name="sale_approval_status" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>