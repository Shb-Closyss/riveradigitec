    <record id="res_partner_inherit" model="ir.ui.view">
        <field name="name">res.partner_inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref='base.view_partner_form'/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='warning_tax']" position="before">
                <header>
                    <button type="object" string="Send for approval" name="action_send_approval" class="btn-primary"
                            invisible="active == True or sale_approval_status not in ('new', 'reject')" style="height: 400px;"/>
                    <button name="action_approve" type="object" string="Approve" class="btn btn-success"
                            invisible="not is_current_approver or active == True or sale_approval_status != 'sent'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn btn-danger"
                            invisible="not is_current_approver or active == True or sale_approval_status != 'sent'"/>
                </header>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Approver" invisible="1">
                    <field name="approval_route_id"/>
                </page>
            </xpath>
        </field>
    </record>

