<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="approval_route_document_stage_list" model="ir.ui.view">
            <field name="name">approval_route_document_stage_list</field>
            <field name="model">approval.route.document.stage</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" invisible="True"/>
                    <field name="name"/>
                    <field name="user_ids" widget="many2many_avatar_user"/>
                    <field name="state"/>
                    <field name="decisions_summary"/>
                    <button name="action_approve_stage" type="object" string="Approve" class="btn-success btn-sm" invisible="state != 'pending'"/>
                    <button name="action_reject_stage" type="object" string="Reject" class="btn-danger btn-sm" invisible="state != 'pending'"/>
                </list>
            </field>
        </record>

        <record id="approval_route_document_stage_list_expense" model="ir.ui.view">
            <field name="name">approval_route_document_stage_list_expense</field>
            <field name="model">approval.route.document.stage</field>
            <field name="arch" type="xml">
                <list action="open_record" type="object" create="0" delete="0">
                    <header>
                        <button name="bulk_approve" type="object" string="Approve" class="oe-highlight"/>
                    </header>
                    <field name="sequence" column_invisible="True"/>
                    <field name="name" column_invisible="1"/>
                    <field name="res_model" optional="hide"/>
                    <field name="create_uid" string="Requested By"/>
                    <field name="res_id" string="Document Name" context="{'sale_show_partner_name': 1}"/>
                    <field name="user_ids" widget="many2many_avatar_user"/>
                    <field name="state" widget="badge" decoration-warning="state == 'pending'" decoration-success="state == 'approved'"/>
                    <button name="action_approve_stage" type="object" string="Approve" class="btn-success btn-sm" invisible="state != 'pending'"/>
                    <button name="action_reject_stage" type="object" string="Reject" class="btn-danger btn-sm" invisible="state != 'pending'"/>
<!--                    <field name="decisions_summary"/>-->
                </list>
            </field>
        </record>
        <record id="approval_route_document_stage_list_expense_extra_view" model="ir.ui.view">
            <field name="name">approval_route_document_stage_list_expense</field>
            <field name="model">approval.route.document.stage</field>
            <field name="arch" type="xml">
                <list action="open_record" type="object" create="0" delete="0">
                    <header>
                        <button name="bulk_approve" type="object" string="Approve" class="oe-highlight"/>
                    </header>
                    <field name="sequence" column_invisible="True"/>
                    <field name="name" column_invisible="1"/>
                    <field name="res_model" optional="hide"/>
                    <field name="create_uid" string="Requested By"/>
                    <field name="res_id" string="Document Name"/>
                    <field name="user_ids" widget="many2many_avatar_user"/>
                    <field name="partner_id" string="Vendor / Customer" optional="show"/>
                    <field name="total_amt"/>
                    <field name="state" widget="badge" decoration-warning="state == 'pending'" decoration-success="state == 'approved'"/>
                    <button name="action_approve_stage" type="object" string="Approve" class="btn-success btn-sm" invisible="state != 'pending'"/>
                    <button name="action_reject_stage" type="object" string="Reject" class="btn-danger btn-sm" invisible="state != 'pending'"/>

<!--                    <field name="decisions_summary"/>-->
                </list>
            </field>
        </record>
        <record id="approval_route_document_stage_form" model="ir.ui.view">
            <field name="name">approval_route_document_stage_form</field>
            <field name="model">approval.route.document.stage</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="sequence" invisible="True"/>
                            <field name="name"/>
                            <field name="user_ids" widget="many2many_avatar_user"/>
                            <field name="approval_type"/>
                            <field name="state"/>
                            <field name="decisions_summary"/>
                        </group>
                        <group string="Approver Comment">
                            <field name="approver_comment"
                                   nolabel="1"
                                   placeholder="Add an internal note or comment…"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>