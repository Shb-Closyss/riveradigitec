<?xml version="1.0" encoding="UTF-8" ?>


<odoo>
    <record id="reject_reason_wiz_form_view" model="ir.ui.view">
        <field name="name">Reject</field>
        <field name="model">reject.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                        <field name="res_model" invisible="1"/>
                        <field name="res_id" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="reject" type="object" string="Reject" class="btn-danger"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="reject_reason_form_view" model="ir.ui.view">
        <field name="name">reject.reason.form.view</field>
        <field name="model">xf.reject.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="res_model"/>
                        <field name="res_id"/>
                    </group>
                </sheet>
                <footer>
                    <button type="object" name="action_reject" string="Reject" class="btn btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="xf_reject_reason_actions" model="ir.actions.act_window">
        <field name="name">Reject</field>
        <field name="res_model">xf.reject.reason</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>